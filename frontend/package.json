{
  "name": "coding-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "test": "vitest run --configLoader runner",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.5"
  }
}

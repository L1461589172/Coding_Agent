# Copy this file to .env in the repository root; backend startup loads it automatically.
# Explicit terminal variables take precedence. Never commit a real API key.
CODING_AGENT_WORKSPACE=.
CODING_AGENT_API_KEY=
CODING_AGENT_BASE_URL=
CODING_AGENT_MODEL=
CODING_AGENT_MAX_STEPS=20
CODING_AGENT_HISTORY_DIR=
CODING_AGENT_HISTORY_MAX_SESSIONS=200
CODING_AGENT_HISTORY_MAX_TASKS_PER_SESSION=100
CODING_AGENT_HISTORY_MAX_AGE_DAYS=90
CODING_AGENT_HISTORY_BACKUP_LIMIT=3
CODING_AGENT_HISTORY_BACKUP_MAX_BYTES=67108864
CODING_AGENT_HISTORY_MAX_BYTES=536870912
